<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:visibility="invisible" />

    <!-- 管理页：控制台 / 调试台，用独立 WebView 内嵌，跟看板平级切换 -->
    <WebView
        android:id="@+id/webTool"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="46dp"
        android:background="@color/bg"
        android:visibility="gone" />

    <!-- 控制台/调试台加载进度：细条贴顶，不挡内容 -->
    <ProgressBar
        android:id="@+id/toolProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:layout_marginBottom="46dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/card"
        android:visibility="gone" />

    <!-- 加载失败卡片：贴在页面中间，点一下就重试。总比留一张白纸强 -->
    <TextView
        android:id="@+id/toolError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="46dp"
        android:background="@color/card"
        android:fontFamily="monospace"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:padding="18dp"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 底部页签：看板 / 控制台 / 调试台。放底部是因为拇指够得到，
         而且不会跟顶上看板自己的导航条打架 -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_gravity="bottom"
        android:background="@color/card"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tabBoard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_board"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabConsole"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_console"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabDebug"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_debug"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/boot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingTop="72dp"
            android:paddingRight="28dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/boot_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.02"
                android:text="@string/boot_title"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/boot_sub"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/bootProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent"
                android:max="100" />

            <TextView
                android:id="@+id/bootStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="正在准备运行时…"
                android:textColor="@color/accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/bootLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/muted"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <Button
                android:id="@+id/bootRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/accent"
                android:text="重试"
                android:textColor="#FF06231B"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/menuBtn"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_round_btn"
        android:contentDescription="@string/menu_settings"
        android:padding="9dp"
        android:src="@drawable/ic_menu_dots"
        android:tint="#FFE6EDF3" />

</FrameLayout>
